        ],
        "responses": {
          "200": {
            "description": "Session active"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
